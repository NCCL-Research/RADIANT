{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nccl-research.github.io/RADIANT/benchmark-manifest.schema.json",
  "title": "RADIANT benchmark manifest",
  "description": "Describes benchmark provenance and split artifacts. A valid manifest does not establish label validity or benchmark quality.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "benchmark_id",
    "benchmark_version",
    "status",
    "task_domain",
    "case_source",
    "label_protocol",
    "splits",
    "privacy_review"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1
    },
    "benchmark_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["draft", "pilot", "frozen", "retired"]
    },
    "created_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "task_domain": {
      "type": "string",
      "minLength": 1
    },
    "case_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "description", "authoring_method"],
      "properties": {
        "source_type": {
          "enum": ["researcher_authored_synthetic", "permitted_deidentified", "other"]
        },
        "description": {"type": "string", "minLength": 1},
        "authoring_method": {"type": "string", "minLength": 1},
        "permissions_reference": {"type": ["string", "null"]}
      }
    },
    "label_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_id", "version", "status"],
      "properties": {
        "protocol_id": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "status": {
          "enum": ["not_defined", "draft", "reviewed", "frozen"]
        }
      }
    },
    "splits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["split_id", "purpose", "case_file", "case_count", "sha256"],
        "properties": {
          "split_id": {"type": "string", "minLength": 1},
          "purpose": {
            "enum": ["development", "validation", "test", "other"]
          },
          "case_file": {"type": "string", "minLength": 1},
          "case_count": {"type": "integer", "minimum": 0},
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "pairing_policy": {
      "type": ["string", "null"],
      "description": "How related paraphrase/counterfactual variants are kept together across splits."
    },
    "license": {"type": ["string", "null"]},
    "privacy_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_contains_personal_data", "review_status"],
      "properties": {
        "data_contains_personal_data": {"type": "boolean"},
        "review_status": {
          "enum": ["not_applicable_synthetic_only", "pending", "completed"]
        },
        "notes": {"type": ["string", "null"]}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
